    {
      "name": "7. Casos inválidos y fallas corregidas",
      "item": [
        {
          "name": "P-36 Agregar tarea con fecha inválida",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/addTareas",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "addTareas"
              ]
            },
            "description": "Antes de la corrección (falla F-01) respondía 500 Internal Server Error.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Tarea con fecha inválida\",\n  \"fecha_vencimiento\": \"no-es-fecha\",\n  \"id_proyecto\": 197\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 400 Bad Request (error controlado)\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Explica el error\", () => pm.expect(pm.response.json().error).to.include(\"Dato inválido\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "P-37 Actualizar usuario inexistente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/updateUsuario",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "updateUsuario"
              ]
            },
            "description": "Antes de la corrección (falla F-02) respondía 1 y CREABA un usuario nuevo.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_usuario\": 999999,\n  \"nombre\": \"Usuario Inexistente\",\n  \"correo_electronico\": \"no.existe@prueba.mx\",\n  \"contrasena\": \"x\",\n  \"rol\": \"Estudiante\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 404 Not Found\", () => pm.response.to.have.status(404));",
                  "pm.test(\"Indica que no existe\", () => pm.expect(pm.response.json().detalle).to.eql(\"No existe el usuario con id 999999\"));"
                ]
              }
            }
          ]
        },
        {

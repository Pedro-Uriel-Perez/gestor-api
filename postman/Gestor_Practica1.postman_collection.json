        {
          "name": "P-21 Agregar asignación",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/addAsignacion",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "addAsignacion"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_usuario\": {{id_usuario}},\n  \"id_tarea\": {{id_tarea}},\n  \"fecha_asignacion\": \"2026-10-06\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Responde 1\", () => pm.expect(pm.response.text()).to.eql(\"1\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "P-22 Listar asignaciones",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/buscarAsignaciones",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "buscarAsignaciones"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
                  "const datos = pm.response.json();",
                  "const reg = datos.find(x => x.id_usuario == pm.collectionVariables.get(\"id_usuario\") && x.id_tarea == pm.collectionVariables.get(\"id_tarea\"));",
                  "pm.test(\"Aparece la asignación creada\", () => pm.expect(reg, \"no se encontró la asignación creada\").to.exist);",
                  "if (reg) pm.collectionVariables.set(\"id_asignacion\", reg.id_asignacion);"
                ]
              }
            }
          ]
        },
        {
          "name": "P-23 Buscar asignación por id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/buscarAsignacion?id={{id_asignacion}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "buscarAsignacion"
              ],
              "query": [
                {
                  "key": "id",
                  "value": "{{id_asignacion}}"
                }
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Devuelve el registro correcto\", () => pm.expect(pm.response.json().id_asignacion).to.eql(Number(pm.collectionVariables.get(\"id_asignacion\"))));"
                ]
              }
            }
          ]
        },
        {
          "name": "P-24 Actualizar asignación",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
